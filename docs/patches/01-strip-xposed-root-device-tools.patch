-            if (evidence == ScrollEvidence.DIRECTION_MISMATCH) {
-                return ScrollActionResult.failure(
-                    direction = direction,
-                    code = "DIRECTION_MISMATCH",
-                    message = "界面向请求方向的反方向移动",
-                    method = methodName,
-                    targetIndex = targetIndex,
