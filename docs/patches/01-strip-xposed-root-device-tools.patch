-                while (size < limit && c.moveToNext()) {
-                    add(
-                        JSONObject().also { row ->
-                            columns.forEachIndexed { i, name ->
-                                row.put(
-                                    name,
-                                    if (c.isNull(i)) JSONObject.NULL
