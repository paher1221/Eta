-                    resolver = context.contentResolver,
-                    key = ModuleConfig.SECURE_VOICE_INTERACTION_SERVICE,
-                    targetValue = null,
-                    userId = userId,
-                )
-            }
-
-            if (!managedRole) {
-                completeOemAssistantRestoration(
-                    context = context,
-                    userId = userId,
-                    logger = logger,
-                    roleChanged = false,
-                    finishLock = false,
-                )
-                return
-            }
-            asyncDispatched = true
