-                                }
-                            }
-                        } finally {
-                            latch.countDown()
-                        }
-                    }
-
-                    override fun onFailure(errorCode: Int) {
-                        synchronized(lock) {
-                            if (acceptingResults.get()) failures[window.id] = errorCode
-                        }
-                        latch.countDown()
-                    }
-                })
-            }.onFailure {
-                synchronized(lock) {
