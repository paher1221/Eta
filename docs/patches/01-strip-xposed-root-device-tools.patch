-        val latch = CountDownLatch(captureWindows.size)
-        val screenshots = mutableMapOf<Int, Pair<Bitmap, Rect>>()
-        val failures = mutableMapOf<Int, Int>()
-        val lock = Any()
-        val acceptingResults = AtomicBoolean(true)
-
-        for (window in captureWindows) {
