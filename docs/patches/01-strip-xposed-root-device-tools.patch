-        if (currentClip.description.label?.toString() != temporaryLabel) {
-            // 用户或其他应用已经写入新内容，不能用旧快照覆盖它。
-            return true
-        }
-        return runCatching {
-            if (originalClip != null) {
-                clipboard.setPrimaryClip(originalClip)
-            } else {
