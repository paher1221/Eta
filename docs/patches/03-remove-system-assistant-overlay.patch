-        }
-        val radiusPx = (topRadius.value * density.density)
-            .coerceIn(0f, minOf(size.width * 0.5f, size.height))
-        if (radiusPx <= 0.5f) {
-            return Outline.Rectangle(Rect(0f, 0f, size.width, size.height))
