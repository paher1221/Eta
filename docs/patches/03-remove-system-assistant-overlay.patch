-                    if (node.visibility != View.VISIBLE || isPassword(node.inputType)) continue
-                    output.line("控件", node.className)
-                    output.line("文本", node.text?.toString())
-                    output.line("描述", node.contentDescription?.toString())
-                    output.line("提示", node.hint)
