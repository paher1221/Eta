-        /** 恢复可触摸并淡入；需要取消已排队的恢复时由 [cancelRestore] 撤销。 */
-        fun scheduleCapsuleRestore(delayMs: Long)
-
-        fun cancelRestore()
-    }
-
-    @Volatile
-    private var host: Host? = null
-
-    fun attach(host: Host) {
-        this.host = host
-    }
-
-    fun detach(host: Host) {
-        if (this.host === host) this.host = null
-    }
