-                val x = startX + index * spacing
-                drawLine(
-                    brush = gradient,
-                    start = Offset(x, center.y - halfSpan),
-                    end = Offset(x, center.y + halfSpan),
-                    strokeWidth = stroke,
-                    cap = StrokeCap.Round,
-                )
-            }
-        }
-    }
-}
