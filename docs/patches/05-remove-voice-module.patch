-        override fun onReceive(context: Context, intent: Intent) { if (current === this@SpeechAudioLease) interrupt() }
-    }
-
-    fun acquire(playback: Boolean, beforeFocus: () -> Unit = {}) {
-        current?.interrupt?.invoke()
