-private fun checkedAudio(total: Long, added: Int): Long {
-    val next = total + added
-    if (next > MAX_AUDIO_BYTES) {
-        throw SpeechFailure(
-            SpeechErrorCode.PROTOCOL,
-            AppStrings.get(R.string.voice_i18n_audio_format_or_length_invalid, "语音音频格式或长度无效"),
-        )
-    }
-    return next
-}
