+-            } catch (failure: RuntimeException) {
+-                logFailure("Runtime 请求的无障碍恢复失败", failure)
+-            }
+-        }
+-        if (!posted) {
+-            runtimeRecoveryScheduled.set(false)
+-        }
+-        return posted
+-    }
