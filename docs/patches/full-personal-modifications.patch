+-    private val beforeCapture: () -> Unit = {},
+-    private val afterCapture: () -> Unit = {},
+-    private val refiner: SpeechTranscriptRefiner = SpeechTranscriptRefiner(),
+-    private val createRecorder: () -> SpeechAudioCapture = ::SpeechRecorder,
