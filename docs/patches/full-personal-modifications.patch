+-        val virtualDisplay = createTrustedVirtualDisplay(surface, width, height, densityDpi)
+-        if (virtualDisplay == null) {
+-            surface.release()
+-            println(RESULT_PREFIX + JSONObject().put("ok", false).put("code", "CREATE_DISPLAY_FAILED"))
+-            exitProcess(1)
+-        }
