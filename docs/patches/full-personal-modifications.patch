+-class EtaVoiceInteractionService : VoiceInteractionService() {
+-    override fun onReady() {
+-        super.onReady()
+-        activeService = this
+-        if (Build.VERSION.SDK_INT >= 37) {
+-            setInvocationEffectEnabled(true)
+-        }
+-    }
+-
+-    override fun onShutdown() {
+-        if (activeService === this) activeService = null
+-        super.onShutdown()
+-    }
