+-/**
+- * 画布内生微距触控光效：点击呈现双层阻尼水波纹，滑动呈现流光尾迹。
+- */
+-@Composable
+-private fun VirtualTouchEffectOverlay(
+-    effect: VirtualTouchEffect?,
+-    accent: Color,
+-) {
+-    if (effect == null) return
