-        startedAt = time
-    }
-
-    private fun apply(name: String, time: Float, level: Float) {
-        for (track in animations.getValue(name)) {
-            val keys = track.keys
-            val right = keys.indexOfFirst { it.time > time }.let { if (it < 0) keys.lastIndex else it }
-            val left = (right - 1).coerceAtLeast(0)
-            val from = keys[left]
-            val to = keys[right]
