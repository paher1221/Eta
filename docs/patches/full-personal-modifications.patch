+-            }
+-            if (target.viewId.isNotBlank() && sourceViewId.isNotBlank()) {
+-                return target.viewId == sourceViewId && target.className == sourceClassName
+-            }
+-            return target.className == sourceClassName && target.bounds == sourceBounds
+-        }
