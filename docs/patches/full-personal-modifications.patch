-    private fun inferScrollAnchorDelta(
-        before: List<ScrollAnchor>,
-        after: List<ScrollAnchor>,
-        direction: ScrollDirection,
-    ): Int? {
-        fun unique(anchors: List<ScrollAnchor>): Map<String, ScrollAnchor> = anchors
