-            else ""
-        val fallbackSsid =
-            WIFI_STATUS_SSID.find(rootWifiStatus)?.groupValues?.get(1)?.trim()?.trim('"')
-        val fallbackRssi = WIFI_STATUS_RSSI.find(rootWifiStatus)?.groupValues?.get(1)?.toIntOrNull()
