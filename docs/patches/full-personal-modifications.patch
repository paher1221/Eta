+-                s.columns.toTypedArray(),
+-                "0",
+-                null,
+-                null,
+-            )
+-            ?.use { true } ?: false
+-    }
+-
+-    companion object {
+-        private fun columns(value: String) = value.split(',')
+-
+-        val sources =
+-            mapOf(
