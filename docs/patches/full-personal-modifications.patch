+-            } finally {
+-                mainHandler.post {
+-                    releaseRetainedDisplay()
+-                    exitProcess(0)
+-                }
+-            }
+-        }, "eta-vd-stdin-watcher").apply {
+-            isDaemon = true
+-            start()
+-        }
+-
+-        try {
+-            Looper.loop()
+-        } finally {
+-            releaseRetainedDisplay()
+-        }
+-        exitProcess(0)
+-    }
