-                    .toString()
-            }
-            Thread.sleep(350)
-        }
-        return JSONObject()
-            .put("ok", false)
-            .put("tool", "wait_for_text")
-            .put("code", "TIMEOUT")
-            .put("message", "等待文本超时：$needle")
