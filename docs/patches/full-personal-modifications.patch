+-        val shimmerShift = sin(seconds * 1.35f) * width * 0.12f
+-        val rimShader = LinearGradient(
+-            shimmerShift,
+-            height,
+-            width + shimmerShift,
+-            height,
+-            bottomRimGradientArgb,
+-            floatArrayOf(0f, 0.18f, 0.42f, 0.64f, 0.84f, 1f),
