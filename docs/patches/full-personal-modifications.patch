+-                    } else {
+-                        if (Prefs.isEnabled(Prefs.Keys.ASSISTANT_AUTO_CONFIG)) {
+-                            AssistantManager.scheduleAssistantRecovery(
+-                                context = context,
+-                                logger = hooks.logger,
+-                                handler = mainHandler,
+-                                forceRefresh = true,
+-                            )
+-                        }
+-                        chain.proceed()
+-                    }
+-                }
+-            }
+-        }
+-    }
+-}
