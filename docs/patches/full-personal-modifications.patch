+-        val displayId = virtualDisplay.display?.displayId ?: Display.INVALID_DISPLAY
+-        if (displayId <= 0) {
+-            runCatching { virtualDisplay.release() }
+-            surface.release()
+-            println(RESULT_PREFIX + JSONObject().put("ok", false).put("code", "INVALID_DISPLAY_ID"))
+-            exitProcess(1)
+-        }
