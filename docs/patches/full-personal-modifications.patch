+-                                                            R.string.voice_i18n_progress_hold_to_talk,
+-                                                            "松开发送，移出取消",
+-                                                        )
+-                                                    } else {
+-                                                        AppStrings.get(
+-                                                            R.string.voice_i18n_progress_listening_tap_done,
+-                                                            "正在聆听，点击完成结束",
+-                                                        )
+-                                                    },
+-                                                )
+-                                            }
+-                                        },
+-                                        onLevel = { level -> update { it.copy(level = level) } },
+-                                    )
+-                                } finally {
+-                                    if (generation == session) releaseCapture()
+-                                }
