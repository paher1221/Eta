+-            "INSERT INTO memories VALUES (?, ?, ?, ?, ?)",
+-            arrayOf<Any>(id, text, createdTime, deleted, recycleTime),
+-        )
+-    }
+-
+-    private fun query(operation: String, keyword: String = ""): JSONObject = JSONObject(
