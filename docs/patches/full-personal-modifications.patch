+-            .firstOrNull()
+-            ?.also {
+-                it.put("event_id", id.toString())
+-                it.put(
+-                    "reminders",
+-                    JSONArray(
+-                        rows(
+-                            uri("reminders"),
+-                            arrayOf("minutes", "method"),
+-                            "event_id=?",
+-                            arrayOf(id.toString()),
+-                            null,
