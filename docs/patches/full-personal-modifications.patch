+-    fun waitMs(durationMs: Int): String {
+-        val duration = durationMs.coerceIn(100, 30_000)
+-        Thread.sleep(duration.toLong())
+-        return JSONObject()
+-            .put("ok", true)
+-            .put("tool", "wait")
+-            .put("duration_ms", duration)
+-            .toString()
