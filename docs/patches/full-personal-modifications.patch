+-            else -> colors.controlSurface
+-        },
+-        animationSpec = tween(180, easing = FastOutSlowInEasing),
+-        label = "assistant_trailing_bg",
+-    )
+-    val trailingIconTint by animateColorAsState(
+-        targetValue = when {
