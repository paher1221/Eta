-private const val MAX_WS_BILLING_CHARS = 9_500
-private const val MAX_WS_UTF8_BYTES = 60 * 1024
-private const val MAX_DEEPSEEK_STREAM_AUDIO_BYTES = 24_000L * 2L * 60L * 30L
