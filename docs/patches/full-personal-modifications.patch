+-        println("$READY_PREFIX$displayId")
+-        System.out.flush()
+-
+-        val mainHandler = android.os.Handler(Looper.getMainLooper())
+-        Thread({
+-            try {
+-                while (true) {
+-                    val line = reader.readLine() ?: break
+-                    if (line.trim() == "release") break
+-                }
+-            } catch (_: Throwable) {
