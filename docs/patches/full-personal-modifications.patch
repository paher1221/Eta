+-
+-        val repaired = DexKitNativeLibraryFile.extract(apk.path, cache, listOf("arm64-v8a"))
+-
+-        assertArrayEquals("library-one".toByteArray(), repaired.readBytes())
+-        assertFalse(repaired.canWrite())
