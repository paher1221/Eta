-    componentName: String,
-): String? {
-    val entries = accessibilityServiceEntries(currentValue)
-    val targetIdentity = flattenedComponentIdentity(componentName)
-    if (
-        entries.any { entry ->
-            entry == componentName ||
-                (
-                    targetIdentity != null &&
