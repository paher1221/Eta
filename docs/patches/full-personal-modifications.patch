-            logFailure("无法重新启用 Eta 无障碍服务", failure)
-        } finally {
-            repairInProgress.set(false)
-        }
-        if (isEnforcementEnabled(context)) {
-            scheduleHealthCheck(
-                context = context,
-                reason = "repair_${attempt.number}_confirmation",
-                delayMs = SERVICE_REBIND_GRACE_MS,
-            )
