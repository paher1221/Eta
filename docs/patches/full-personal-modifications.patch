+-    private fun uri(table: String): Uri =
+-        Uri.parse("content://${userId?.let { "$it@" }.orEmpty()}com.android.calendar/$table")
+-
+-    private val eventColumns =
+-        arrayOf(
+-            "_id",
+-            "calendar_id",
+-            "title",
+-            "description",
+-            "eventLocation",
+-            "dtstart",
+-            "dtend",
+-            "eventTimezone",
+-            "allDay",
