+-            contentDescription = stringResource(R.string.voice_use_keyboard),
+-            surfaceColor = colors.chipBackground,
+-            strokeColor = colors.chipStroke,
+-            iconTint = colors.inputPrimary,
+-            dark = colors.dark,
